# Copy this file to `.env` (git-ignored) and fill in your Stream credentials.
# Find these in your Stream dashboard: https://dashboard.getstream.io
#
# These are used by the Cloud Functions in index.js to create Stream users
# and mint per-user tokens. The API_SECRET must never be committed or shipped
# in the iOS app — it stays server-side only.

API_KEY=your-stream-api-key
API_SECRET=your-stream-api-secret
